# ============================================================================
# SAT Mock Telegram Mini App — environment template.
# Copy to ".env" and fill in the values marked PASTE_ME.
# ============================================================================

# ---- App ----
ENV=development
DEBUG=true
LOG_JSON=false
APP_NAME=satzone-miniapp
API_V1_PREFIX=/api/v1

# ---- Mini-app's own Postgres (managed by this docker-compose) ----
POSTGRES_HOST=miniapp-db
POSTGRES_PORT=5432
POSTGRES_USER=miniapp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=miniapp

# ---- Read-only access to the satzone Postgres ----
# Run ops/satzone-ro.sql against the satzone DB to create this role first.
# When the satzone DB runs on the host (your laptop / VM), use host.docker.internal.
SATZONE_DB_HOST=host.docker.internal
SATZONE_DB_PORT=5433
SATZONE_DB_USER=miniapp_ro
SATZONE_DB_PASSWORD=PASTE_ME_strong_readonly_password
SATZONE_DB_NAME=satzone

# ---- Optional: satzone admin API (currently unused but kept for the future) ----
SATZONE_API_BASE=http://host.docker.internal:8080/api/v1
SATZONE_ADMIN_TOKEN=

# ---- Telegram bot ----
# Get the token from @BotFather in Telegram, then paste below.
TELEGRAM_BOT_TOKEN=PASTE_ME_BotFather_token
TELEGRAM_INIT_DATA_TTL_SECONDS=86400

# ---- Mini-app admin allowlist (comma-separated E.164 phones) ----
# Phones in this list bypass the satzone user-lookup and get the 'admin' role
# automatically when they share their Telegram contact.
ADMIN_PHONES=+998901234567

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=PASTE_ME_long_random_secret
JWT_ALG=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# ---- Redis (managed by this docker-compose) ----
REDIS_HOST=miniapp-redis
REDIS_PORT=6379
REDIS_DB=0

# ---- Storage ----
STORAGE_BACKEND=local
MEDIA_DIR=/app/media
MEDIA_URL_PREFIX=/media
# Filled when STORAGE_BACKEND=s3
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=

# ---- CORS ----
BACKEND_CORS_ORIGINS=http://localhost:5173,https://your-miniapp.example.com
FRONTEND_URL=https://your-miniapp.example.com

# ---- Frontend build-time ----
# Where the frontend should send API requests. /api/v1 is fine when the
# frontend is served from the same origin (nginx in docker-compose).
VITE_API_BASE=/api/v1
WEBSITE_URL=https://your-website.example.com

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20
SUBMISSION_GRACE_SECONDS=10
