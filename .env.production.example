# ============================================================================
# Production environment template for satzonemini.me.
# Copy to ".env" on the server and fill in every PASTE_ME / SECRET_xxx value.
# ============================================================================

# ---- App ----
ENV=production
DEBUG=false
LOG_JSON=true
APP_NAME=satzone-miniapp
API_V1_PREFIX=/api/v1

# ---- Mini-app's own Postgres ----
POSTGRES_HOST=miniapp-db
POSTGRES_PORT=5432
POSTGRES_USER=miniapp
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=PASTE_ME_strong_db_password
POSTGRES_DB=miniapp

# ---- Read-only access to satzone's Postgres ----
# This is the satzone server's Tailscale IP (or private network IP).
# Example: 100.x.y.z
SATZONE_DB_HOST=PASTE_ME_satzone_private_ip
SATZONE_DB_PORT=5432
SATZONE_DB_USER=miniapp_ro
# Set this to the same password you wrote into ops/satzone-ro.sql.
SATZONE_DB_PASSWORD=PASTE_ME_strong_readonly_password
SATZONE_DB_NAME=satzone

# ---- Satzone admin API (optional, currently unused; leave blank) ----
SATZONE_API_BASE=
SATZONE_ADMIN_TOKEN=

# ---- Telegram bot ----
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=PASTE_ME_BotFather_token
TELEGRAM_INIT_DATA_TTL_SECONDS=86400

# ---- Mini-app admin allowlist (comma-separated E.164 phones) ----
# Phones in this list bypass the satzone lookup and get the 'admin' role.
ADMIN_PHONES=+998943210413

# ---- Auth ----
# Generate: openssl rand -hex 32
JWT_SECRET=PASTE_ME_64_char_hex
JWT_ALG=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# ---- Redis ----
REDIS_HOST=miniapp-redis
REDIS_PORT=6379
REDIS_DB=0

# ---- Storage ----
STORAGE_BACKEND=local
MEDIA_DIR=/app/media
MEDIA_URL_PREFIX=/media

# ---- CORS / URLs ----
BACKEND_CORS_ORIGINS=https://satzonemini.me
FRONTEND_URL=https://satzonemini.me
# Where students go to register / buy courses (the main website).
WEBSITE_URL=https://satzone.example.com

# ---- Frontend build-time ----
VITE_API_BASE=/api/v1

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20
SUBMISSION_GRACE_SECONDS=10
